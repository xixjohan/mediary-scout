# 巡影 (Mediary Scout) 本地开发与真实验证环境配置模板
# 复制此文件为 env/.envdev（已被 .gitignore 严格忽略，绝不入库）以进行本地调试与真实验证

# ----------------------------------------------------------------------------
# 1. STRM 播放与网盘真实验证参数 (STRM Playback & Real Storage Verification)
# ----------------------------------------------------------------------------
# 目标网盘存储 ID（例如 115 存储 cs_3204551）
TEST_STRM_STORAGE_ID=cs_3204551

# 目标测试文件 ID（例如 115 中的视频文件 ID）
TEST_STRM_FILE_ID=3551693272365663529

# 目标测试文件提取码（PickCode，例如 115 提取码）
TEST_STRM_PICKCODE=cs3a89o5pq02qdbx4

# 目标视频文件名
TEST_STRM_FILE_NAME=ドラゴンボール超（スーパー） - S01E01 - 第 1 集.mkv

# 目标 STRM 播放测试直链地址
TEST_STRM_PLAY_URL=http://127.0.0.1:3001/api/strm/play/cs_3204551/3551693272365663529?name=%E3%83%89%E3%83%A9%E3%82%B4%E3%83%B3%E3%83%9C%E3%83%BC%E3%83%AB%E8%B6%85%EF%BC%88%E3%82%B9%E3%83%BC%E3%83%91%E3%83%BC%EF%BC%89%20-%20S01E01%20-%20%E7%AC%AC%201%20%E9%9B%86.mkv

# 播放器模拟 User-Agent（用于验证防盗链与 CDN 验签匹配）
TEST_PLAYER_USER_AGENT=Infuse/7.7.1 (Apple TV; tvOS 17.0)

# ----------------------------------------------------------------------------
# 2. 115 网盘真实验证凭据（仅供本地离线脚本或直连测试，生产数据库已做 AES 凭据加密）
# ----------------------------------------------------------------------------
# PAN115_COOKIE=UID=...; CID=...; SEID=...
