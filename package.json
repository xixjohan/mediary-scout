{
  "name": "media-track",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "tsc --project packages/shared/tsconfig.json",
    "build:workflow": "npm run build:shared && tsc --project packages/workflow/tsconfig.json",
    "build:worker": "tsc --project apps/host-worker/tsconfig.json",
    "dev:web": "npm run build:workflow && next dev apps/web --turbopack",
    "build:web": "npm run build:workflow && next build apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "gate:layout": "node scripts/check-layout.mjs",
    "gate:style": "node scripts/check-style-tokens.mjs",
    "gate:assets": "node scripts/check-build-assets.mjs",
    "drill:restore": "node scripts/sqlite-restore-drill.mjs",
    "upstream:audit": "node scripts/audit-upstream.mjs",
    "upstream:fetch-audit": "node scripts/audit-upstream.mjs --fetch",
    "gate:deps": "depcruise --config .dependency-cruiser.cjs --ignore-known=.dependency-cruiser-known-violations.json apps packages workers",
    "gate": "npm run gate:layout && npm run gate:deps && npm run gate:style && npm run gate:assets && npm run lint && npm run typecheck",
    "e2e:server": "next start apps/web -p 3100",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ci": "npm run build:web && npm run e2e"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.5.0",
    "playwright": "^1.60.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@waffo/pancake-ts": "0.25.0",
    "ai": "^6.0.201",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "allowScripts": {
    "@electron/rebuild@3.7.2": true,
    "@electron/rebuild@3.6.1": true,
    "better-sqlite3@12.11.1": true,
    "electron@33.4.11": true,
    "electron-builder@25.1.8": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true
  }
}
