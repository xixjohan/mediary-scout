{
  "name": "media-track",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "tsc --project packages/shared/tsconfig.json",
    "build:workflow": "npm run build:shared && tsc --project packages/workflow/tsconfig.json",
    "build:worker": "tsc --project apps/host-worker/tsconfig.json",
    "dev": "node tools/runner/dev-server.mjs",
    "dev:fast": "node tools/runner/dev-server.mjs",
    "dev:web": "npm run build:workflow && next dev apps/web --turbopack",
    "build:web": "npm run build:workflow && next build apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tools/runner/smoke-tester.mjs",
    "test:strm-live": "npx tsx tools/runner/verify-strm-live.mjs",
    "smoke": "node tools/runner/smoke-tester.mjs",
    "typecheck": "tsc --noEmit && tsc --project apps/web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "deploy:check": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -CheckOnly",
    "deploy:dev": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -Mode Dev",
    "deploy:hot": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -PublicOnly",
    "deploy:official": "powershell -ExecutionPolicy Bypass -File scripts/deploy-remote.ps1 -Mode Official",
    "gate:layout": "node tools/gates/check-layout.mjs",
    "gate:server-actions": "node tools/gates/check-server-actions.mjs",
    "gate:facades": "node tools/gates/check-facades.mjs",
    "gate:style": "node tools/gates/check-style-tokens.mjs",
    "gate:assets": "node tools/gates/check-build-assets.mjs",
    "gate:http-timeout": "node tools/gates/check-http-timeout.mjs",
    "gate:acquisition": "node tools/gates/check-acquisition-pipeline.mjs",
    "gate:episodes": "node tools/gates/check-episode-preservation.mjs",
    "gate:catalog": "node tools/gates/check-catalog-discovery.mjs",
    "gate:limits": "node scripts/gate-code-limits.mjs",
    "gate:parity": "node tools/gates/check-feature-parity.mjs",
    "gate:blocking-routes": "node tools/gates/check-blocking-routes.mjs",
    "gate:modals": "node tools/gates/check-modals-and-dialogs.mjs",
    "gate:contracts": "node tools/gates/check-api-contracts.mjs",
    "gate:hydration": "node tools/gates/check-hydration-safety.mjs",
    "gate:suspense": "node tools/gates/check-suspense-fallbacks.mjs",
    "drill:restore": "node scripts/sqlite-restore-drill.mjs",
    "upstream:audit": "node tools/upstream/audit-upstream.mjs",
    "upstream:fetch-audit": "node tools/upstream/audit-upstream.mjs --fetch",
    "gate:deps": "depcruise --config .dependency-cruiser.cjs --ignore-known=.dependency-cruiser-known-violations.json apps packages workers",
    "gate:post-ingest": "node tools/gates/check-post-ingest-automation.mjs",
    "gate": "npm run gate:limits && npm run gate:parity && npm run gate:blocking-routes && npm run gate:hydration && npm run gate:suspense && npm run gate:modals && npm run gate:contracts && npm run gate:layout && npm run gate:deps && npm run gate:server-actions && npm run gate:acquisition && npm run gate:episodes && npm run gate:inspection && npm run gate:strm && npm run gate:post-ingest && npm run gate:catalog && npm run gate:facades && npm run gate:style && npm run gate:assets && npm run gate:http-timeout && npm run lint && npm run typecheck",
    "e2e:server": "next start apps/web -p 3100",
    "e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "e2e:ci": "npm run build:web && npm run e2e",
    "gate:strm": "node tools/gates/check-strm-generation.mjs && node tools/gates/check-strm-playback.mjs",
    "gate:strm-playback": "node tools/gates/check-strm-playback.mjs",
    "gate:inspection": "node tools/gates/check-untracked-title-inspection.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.5.0",
    "playwright": "^1.60.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@waffo/pancake-ts": "0.25.0",
    "ai": "^6.0.201",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "allowScripts": {
    "@electron/rebuild@3.7.2": true,
    "@electron/rebuild@3.6.1": true,
    "better-sqlite3@12.11.1": true,
    "electron@33.4.11": true,
    "electron-builder@25.1.8": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "sharp@0.34.5": true
  }
}
